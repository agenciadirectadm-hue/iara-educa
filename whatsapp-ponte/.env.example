# Ponte do WhatsApp da IARA Educa — MOLDE. O valor real fica em .env (fora do git).
# `npm run configurar` cria o .env e gera o segredo; o banco guarda só o hash dele.

# Gateway da IARA Educa (Edge Function `api`)
IARA_API_URL=https://fqpjbyhewzngutbyydig.supabase.co/functions/v1/api

# Número do chip, com + e DDI (o mesmo da IARA Saúde: ligue um de cada vez)
IARA_WHATSAPP_NUMERO=+5544997748259

# Segredo da ponte (gerado pelo configurar.mjs — quem tiver este valor fala com o gateway como a ponte)
IARA_CANAL_SEGREDO=

# Página local do QR de pareamento (a ponte da Saúde usa 5199)
PORTA_QR=5299
